T.TP:AddButton({
    Title = "🚀 Teleport ke Pemain",
    Callback = function()
        local name = selPlayer.name
        if name == "" then Fluent:Notify({Title="Error", Content="Pilih pemain dulu.", Duration=3}); return end
        local target
        for _, p in ipairs(Svc.Players:GetPlayers()) do
            if p.Name == name then target = p; break end
        end
        if not target then Fluent:Notify({Title="Error", Content=name.." tidak ada.", Duration=3}); return end
        local tChar = target.Character
        local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
        if tRoot then
            fastTP(tRoot.Position)
            addLog("TP → "..name)
            Fluent:Notify({Title="Teleport", Content="TP ke "..name.." berhasil!", Duration=3})
        else
            Fluent:Notify({Title="Error", Content="Karakter "..name.." tidak tersedia.", Duration=3})
        end
    end,
})

