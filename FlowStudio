-- ─────────────────────────────────────────
--  MONITOR LOOP
-- ─────────────────────────────────────────
task.spawn(function()
    task.wait(2)  -- Beri Fluent waktu fully render

    local function safeSet(obj, data)
        pcall(function() obj:SetValues(data) end)
    end

    while true do
        pcall(function()
            local pStats = LP:FindFirstChild("leaderstats")
            local cur = pStats and pStats:FindFirstChild("Money") and pStats.Money.Value or 0
            if Ses.StartMoney == 0 and cur > 0 then Ses.StartMoney = cur end
            Ses.CurrentProfit = cur - Ses.StartMoney
            local elapsed = math.max(1, math.floor((os.time() - Ses.StartTime) / 60))
            local pph = math.floor(Ses.CurrentProfit / elapsed * 60)
            local icon = Cfg.AutoFarm and "🟢" or "⚪"

            safeSet(miniLog, {
                Title = "Activity Log",
                Content = ("%s %s  |  Job: %s\nProfit: $%d  |  /Jam: ~$%d  |  %dm\n─────────────\n%s"):format(
                    icon, Cfg.AutoFarm and "FARMING" or "Idle",
                    Cfg.Job, Ses.CurrentProfit, pph, elapsed,
                    #Ses.Logs > 0 and table.concat(Ses.Logs, "\n") or "Belum ada aktivitas."
                )
            })

            -- Update player list di tab Players
            local plist = {}
            for _, p in ipairs(Svc.Players:GetPlayers()) do
                table.insert(plist, (p == LP and "★ " or "  ") .. p.Name)
            end
            safeSet(playerInfo, {
                Title = "Players Online ("..#Svc.Players:GetPlayers()..")",
                Content = table.concat(plist, "\n")
            })
        end)

        task.wait(1)
    end
end)

