local flyConn, flyBV, flyBGyro
local function setFly(on)
    Cfg.Fly = on
    if flyConn then flyConn:Disconnect(); flyConn = nil end
    local char = LP.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum  = char:FindFirstChild("Humanoid")
    if not root or not hum then return end
    if flyBV    then pcall(function() flyBV:Destroy()    end); flyBV    = nil end
    if flyBGyro then pcall(function() flyBGyro:Destroy() end); flyBGyro = nil end
    if on then
        hum.PlatformStand = true
        flyBV = Instance.new("BodyVelocity", root)
        flyBV.MaxForce, flyBV.Velocity = Vector3.new(1e5,1e5,1e5), Vector3.zero
        flyBGyro = Instance.new("BodyGyro", root)
        flyBGyro.MaxTorque, flyBGyro.P = Vector3.new(1e5,1e5,1e5), 1e4
        flyConn = Svc.RunService.RenderStepped:Connect(function()
            if not Cfg.Fly or not flyBV or not flyBV.Parent then return end
            local cam = Svc.Workspace.CurrentCamera
            local UIS = Svc.UserInputService
            local fwd = (UIS:IsKeyDown(Enum.KeyCode.W) and 1 or 0) - (UIS:IsKeyDown(Enum.KeyCode.S) and 1 or 0)
            local rgt = (UIS:IsKeyDown(Enum.KeyCode.D) and 1 or 0) - (UIS:IsKeyDown(Enum.KeyCode.A) and 1 or 0)
            local up  = (UIS:IsKeyDown(Enum.KeyCode.Space) and 1 or 0) - (UIS:IsKeyDown(Enum.KeyCode.LeftShift) and 1 or 0)
            flyBV.Velocity  = (cam.CFrame.LookVector*fwd + cam.CFrame.RightVector*rgt + Vector3.new(0,1,0)*up) * Cfg.FlySpeed
            flyBGyro.CFrame = cam.CFrame
        end)
    else
        hum.PlatformStand = false
    end
end

