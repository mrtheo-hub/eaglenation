-- /// CORE EXPLOIT FUNCTIONS ///

local function getRoot()
    return Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
end

local function teleport(pos)
    local root = getRoot()
    if not root then return end
    
    -- Speed-based Tweening
    local distance = (root.Position - pos).Magnitude
    local duration = distance / Config.Speed
    local tween = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))})
    tween:Play()
    tween.Completed:Wait()
end

-- Infinite Jump Logic
game:GetService("UserInputService").JumpRequest:Connect(function()
    if Toggles.InfJump then
        Player.Character:FindFirstChildOfClass("Humanoid"):ChangeState("Jumping")
    end
end)

-- /// FARMING LOGIC ///
task.spawn(function()
    while true do
        task.wait(0.1)
        if Toggles.AutoFarm then
            local backpack = Player:FindFirstChild("Backpack")
            local char = Player.Character
            
            -- Step 1: Grab Wheat[cite: 1]
            if not (backpack:FindFirstChild("Wheat") or (char and char:FindFirstChild("Wheat"))) then
                teleport(POS_HAY)
                for i=1, 5 do -- Rapid check
                    local p = nil
                    for _, obj in pairs(workspace:GetPartBoundsInRadius(getRoot().Position, 15)) do
                        p = obj:FindFirstChildOfClass("ProximityPrompt") or obj.Parent:FindFirstChildOfClass("ProximityPrompt")
                        if p then break end
                    end
                    if p then
                        fireproximityprompt(p)
                        task.wait(Config.Delay)
                        break
                    end
                    task.wait(0.1)
                end
            end

            -- Step 2: Feed Horse[cite: 1]
            if Toggles.AutoFarm then
                teleport(POS_HORSES[horseIndex])
                task.wait(0.3)
                local p = nil
                for _, obj in pairs(workspace:GetPartBoundsInRadius(getRoot().Position, 15)) do
                    p = obj:FindFirstChildOfClass("ProximityPrompt") or obj.Parent:FindFirstChildOfClass("ProximityPrompt")
                    if p then break end
                end
                
                if p then
                    fireproximityprompt(p)
                    task.wait(Config.Delay + 1)
                end
                horseIndex = (horseIndex % #POS_HORSES) + 1
            end
        end
    end
end)

