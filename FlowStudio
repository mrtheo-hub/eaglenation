-- ============= ANTI-STAFF MODULE (TRIPLE CHECK) =============
local StaffGroupID = 5177284
local StaffRankThreshold = 10
local ManualStaffIDs = {12345678} -- Backup ID Check

local function isStaff(plr)
    if table.find(ManualStaffIDs, plr.UserId) then return true end
    local success, rank = pcall(function() return plr:GetRankInGroup(StaffGroupID) end)
    if success and rank and rank >= StaffRankThreshold then return true end
    local tags = plr:FindFirstChild("tags")
    if tags and tags:IsA("StringValue") and (tags.Value:lower():match("admin") or tags.Value:lower():match("mod")) then
        return true
    end
    return false
end

local function RunSecurityProtocol(plrName)
    FlowConfig.AutoFarm = false
    addLog("SECURITY: Staff Detected (" .. plrName .. "). Hopping...")
    local success, servers = pcall(function()
        return Services.HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=10"))
    end)
    if success and servers and servers.data then
        for _, srv in ipairs(servers.data) do
            if srv.playing < srv.maxPlayers and srv.id ~= game.JobId then
                Services.TeleportService:TeleportToPlaceInstance(game.PlaceId, srv.id, Player)
                return
            end
        end
    end
    Player:Kick("Error Code: 277\nPlease check your internet connection.")
end

