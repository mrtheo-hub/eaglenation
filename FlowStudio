task.spawn(function()
    task.wait(0.5)
    local fg
    for _, g in ipairs(Svc.CoreGui:GetChildren()) do
        if g:IsA("ScreenGui")
        and g.Name ~= "FlowTog10"
        and g.Name ~= "RobloxGui"
        and #g:GetDescendants() > 20 then
            fg = g; break
        end
    end
    if not fg then return end
    for _, obj in ipairs(fg:GetDescendants()) do
        pcall(function()
            if obj:IsA("Frame") or obj:IsA("ScrollingFrame") then
                if obj.BackgroundTransparency < 0.9 then
                    local r = obj.BackgroundColor3.R * 255
                    local g = obj.BackgroundColor3.G * 255
                    local b = obj.BackgroundColor3.B * 255
                    if r < 55 and g < 55 and b < 65 then
                        obj.BackgroundColor3 = (r < 20 and g < 20 and b < 25) and C.BG or C.CARD
                    end
                end
            elseif obj:IsA("UIStroke") then
                local r = obj.Color.R * 255
                local g = obj.Color.G * 255
                local b = obj.Color.B * 255
                if not ((b > r + 20) and (b > g + 20) and (b > 80)) then
                    obj.Color = C.LINE
                end
            elseif obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                local r = obj.TextColor3.R * 255
                local g = obj.TextColor3.G * 255
                local b = obj.TextColor3.B * 255
                if r > 140 and g > 140 and b > 140 and r < 200 then
                    obj.TextColor3 = C.TEXT
                end
            end
        end)
    end
end)

