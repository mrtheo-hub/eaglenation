}

local TitikWheat = CFrame.new(13382.58, 149.05, 2984.82) 

local function getTitikKudaTerdekat(targetPosition)
    local jarakTerdekat = math.huge
    local titikTerbaik = nil
    
    for _, titikManual in pairs(TitikKuda) do
        local jarak = (titikManual.Position - targetPosition).Magnitude
        if jarak < jarakTerdekat then
            jarakTerdekat = jarak
            titikTerbaik = titikManual
        end
    end
    
    return titikTerbaik
end

