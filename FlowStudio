-- ============= CORE FARM ENGINE =============
local function runFarmCycle()
    while FlowConfig.AutoFarm do
        local root = getRoot()
        if not root then task.wait(1) continue end

        -- Auto Refuel Check
        if FlowConfig.AutoRefuel then
            local veh = getVehicle()
            if veh then
                local fuel = veh:FindFirstChild("Fuel") or veh:FindFirstChild("Gas")
                if fuel and fuel:IsA("NumberValue") and fuel.Value < 20 then
                    addLog("Low fuel. Routing to Gas Station...")
                    if tweenTo(TP.GasStation) then
                        task.wait(1)
                        if interactPrompts({"fill", "refuel", "gas"}, 5) then
                            addLog("Vehicle Refueled!")
                        end
                    end
                end
            end
        end

        local item = Player.Backpack:FindFirstChild("Wheat") or Player.Backpack:FindFirstChild("CementBag")
        if not item and Player.Character then
            item = Player.Character:FindFirstChild("Wheat") or Player.Character:FindFirstChild("CementBag")
        end

        if FlowConfig.Job == "Haybales" then
            if not item then
                if tweenTo(TP.HaySupply) then
                    task.wait(0.2)
                    if interactPrompts({"wheat", "hay", "grab", "take"}) then addLog("Grabbed Hay") end
                end
            else
                local tgt = Targets.Horses[Session.TargetIndex] or Targets.Horses[1]
                if tweenTo(tgt) then
                    task.wait(0.2)
                    if interactPrompts({"feed", "horse", "deliver", "give"}) then
                        addLog("Fed Horse #" .. Session.TargetIndex)
                        Session.TargetIndex = (Session.TargetIndex % #Targets.Horses) + 1
                    end
                end
            end
        elseif FlowConfig.Job == "Construction" then
            if not item then
                if tweenTo(TP.CementSupply) then
                    task.wait(0.2)
                    if interactPrompts({"cement", "bag", "grab", "take"}) then addLog("Grabbed Cement") end
                end
            else
                local tgt = Targets.Mixers[Session.TargetIndex] or Targets.Mixers[1]
                if tweenTo(tgt) then
                    task.wait(0.2)
                    if interactPrompts({"pour", "mixer", "deliver", "insert"}) then
                        addLog("Poured Mixer #" .. Session.TargetIndex)
                        Session.TargetIndex = (Session.TargetIndex % #Targets.Mixers) + 1
                    end
                end
            end
        end
        task.wait(FlowConfig.Speed)
    end
end

