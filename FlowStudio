-- ============= WEBHOOK SYSTEM =============
-- [FIX] Wrap JSONEncode dalam pcall agar tidak crash kalau data malformed
local function SendWebhook(msgType, extraData)
    if not FlowConfig.WebhookURL or FlowConfig.WebhookURL == "" then return end
    if not requestFunc then return end

    local tag = ""
    local isDisconnect = (msgType == "Disconnect")

    if isDisconnect then
        tag = (FlowConfig.DiscordID ~= "") and ("<@" .. FlowConfig.DiscordID .. ">") or "@everyone"
    else
        -- Rate limit: minimal 80 detik antar webhook
        if os.time() - Session.LastWebhook < 80 then return end
        Session.LastWebhook = os.time()
    end

    -- [ADD] Hitung profit per jam
    local elapsedMins = math.max(1, math.floor((os.time() - Session.StartTime) / 60))
    local profitPerHour = math.floor((Session.CurrentProfit / elapsedMins) * 60)

    local embed = {}

    if isDisconnect then
        local reconText = FlowConfig.AutoReconnect and "\n\n**Status:** 🔄 *Reconnecting in 5s...*" or ""
        embed = {
            title       = "🚨 DISCONNECT NOTICE",
            description = "Akun terputus dari server." .. reconText,
            color       = 0xFF4747,
            fields      = {
                { name = "👤 User",   value = "`" .. Player.Name .. "`",           inline = true  },
                { name = "❓ Reason", value = "`" .. tostring(extraData) .. "`",    inline = false },
                { name = "💰 Profit", value = "$" .. Session.CurrentProfit,         inline = true  },
                { name = "⏱ Runtime", value = elapsedMins .. " Menit",             inline = true  }
            },
            footer      = { text = "Flow Studio V1.5 • " .. os.date("%d/%m/%Y %X") }
        }
    else
        embed = {
            title  = "📊 FLOW STUDIO UPDATE",
            color  = 0x47FFAB,
            fields = {
                { name = "👤 User",       value = "`" .. Player.Name .. "`",  inline = true  },
                { name = "💰 Profit",     value = "$" .. Session.CurrentProfit, inline = true },
                { name = "📈 Profit/Jam", value = "$" .. profitPerHour,         inline = true },
                { name = "🔧 Job",        value = FlowConfig.Job,               inline = true },
                { name = "⏱ Runtime",    value = elapsedMins .. " Menit",      inline = true }
            },
            footer = { text = "Flow Studio V1.5 • " .. os.date("%d/%m/%Y %X") }
        }
    end

    -- [FIX] JSONEncode dalam pcall
    local ok, bodyOrErr = pcall(function()
        return Services.HttpService:JSONEncode({
            content = (tag ~= "") and tag or nil,
            embeds  = { embed }
        })
    end)

    if not ok then
        addLog("Webhook encode error: " .. tostring(bodyOrErr))
        return
    end

    pcall(function()
        requestFunc({
            Url     = FlowConfig.WebhookURL,
            Method  = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body    = bodyOrErr
        })
    end)
end

-- ============= CORE FARM ENGINE =============
-- [ADD] Timeout guard: maxStuckTime = 15 detik per fase
local MAX_STUCK_TIME = 15

local function runFarmCycle()
    -- [FIX] Guard agar tidak double-spawn
    if Session.FarmCycleActive then return end
    Session.FarmCycleActive = true

    addLog("Farm dimulai: " .. FlowConfig.Job)

    while FlowConfig.AutoFarm do
        local root = getRoot()
        if not root then
            task.wait(1)
            continue
        end

        -- ── AUTO REFUEL ──
        if FlowConfig.AutoRefuel then
            local veh, fuel = getVehicleInfo()
            if veh and fuel and fuel:IsA("NumberValue") and fuel.Value < 20 then
                addLog("Bensin kritis, menuju SPBU...")
                if veh.PrimaryPart then
                    pcall(function()
                        veh:SetPrimaryPartCFrame(CFrame.new(TP.GasStation + Vector3.new(0, 2, 0)))
                    end)
                else
                    fastTP(TP.GasStation)
                end
                task.wait(1)
                if interactPrompts({ "fill", "refuel", "gas", "pump" }, 5) then
                    addLog("✅ Bensin penuh!")
                else
                    addLog("⚠️ Prompt SPBU tidak ditemukan")
                end
            end
        end

        -- ── CEK ITEM DI BACKPACK / KARAKTER ──
        local function findItem(names)
            for _, name in ipairs(names) do
                local found = Player.Backpack:FindFirstChild(name)
                            or (Player.Character and Player.Character:FindFirstChild(name))
                if found then return found end
            end
            return nil
        end

        -- ── HAYBALES JOB ──
        if FlowConfig.Job == "Haybales" then
            local item = findItem({ "Wheat", "Hay", "HayBale" })

            if not item then
                -- Ambil supply
                fastTP(TP.HaySupply)
                task.wait(FlowConfig.Speed)
                if interactPrompts({ "wheat", "hay", "grab", "pick" }) then
                    addLog("🌾 Hay diambil")
                else
                    addLog("⚠️ Supply tidak responsif")
                end
            else
                -- Antar ke kuda, dengan timeout guard
                local delivered  = false
                local startTime  = os.clock()

                for _, horsePos in ipairs(Targets.Horses) do
                    if not FlowConfig.AutoFarm then break end

                    -- [ADD] Timeout check
                    if os.clock() - startTime > MAX_STUCK_TIME then
                        addLog("⏰ Timeout deliver — skip cycle")
                        break
                    end

                    fastTP(horsePos)
                    task.wait(FlowConfig.Speed)

                    if interactPrompts({ "feed", "horse", "deliver", "give" }) then
                        addLog("🐴 Kuda diberi makan!")
                        delivered = true
                        break
                    end
                end

                if not delivered then
                    addLog("🔍 Kuda lapar tidak ditemukan")
                end
            end

        -- ── CONSTRUCTION JOB ──
        elseif FlowConfig.Job == "Construction" then
            local item = findItem({ "Cement", "CementBag", "Concrete" })

            if not item then
                fastTP(TP.CementSupply)
                task.wait(FlowConfig.Speed)
                if interactPrompts({ "cement", "bag", "grab", "pick" }) then
                    addLog("🧱 Semen diambil")
                else
                    addLog("⚠️ Supply semen tidak responsif")
                end
            else
                local delivered = false
                local startTime = os.clock()

                for _, mixPos in ipairs(Targets.Mixers) do
                    if not FlowConfig.AutoFarm then break end

                    -- [ADD] Timeout check
                    if os.clock() - startTime > MAX_STUCK_TIME then
                        addLog("⏰ Timeout deliver — skip cycle")
                        break
                    end

                    fastTP(mixPos)
                    task.wait(FlowConfig.Speed)

                    if interactPrompts({ "pour", "mixer", "deliver", "dump" }) then
                        addLog("🏗️ Semen dimasukkan!")
                        delivered = true
                        break
                    end
                end

                if not delivered then
                    addLog("🔍 Mixer kosong tidak ditemukan")
                end
            end
        end

        -- Kirim webhook update (sudah ada rate limit 80s di dalam fungsinya)
        SendWebhook("Update")

        task.wait(0.1)
    end

    Session.FarmCycleActive = false
    addLog("Farm dihentikan.")
end

