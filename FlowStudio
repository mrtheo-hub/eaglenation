-- ============= UTILITIES =============
local function addLog(msg)
    table.insert(Session.Logs, 1, string.format("[%s] %s", os.date("%X"), msg))
    if #Session.Logs > 6 then table.remove(Session.Logs, 7) end
end

local function getRoot()
    return Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
end

-- Fast CFrame TP (Solusi lelet 5 menit)
local function fastTP(targetPos)
    local root = getRoot()
    if not root then return false end
    root.CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))
    root.Velocity = Vector3.new(0,0,0)
    task.wait(0.3) -- Jeda pendaratan aman
    return true
end

local function getVehicleInfo()
    local char = Player.Character
    if char and char:FindFirstChild("Humanoid") and char.Humanoid.SeatPart then
        local vehicle = char.Humanoid.SeatPart.Parent
        local fuel = vehicle:FindFirstChild("Fuel") or vehicle:FindFirstChild("Gas")
        return vehicle, fuel
    end
    return nil, nil
end

local function interactPrompts(keywords, holdTime)
    local root = getRoot()
    if not root then return false end
    for _, part in ipairs(Services.Workspace:GetPartBoundsInRadius(root.Position, 15)) do
        local prompt = part:FindFirstChildOfClass("ProximityPrompt") or (part.Parent and part.Parent:FindFirstChildOfClass("ProximityPrompt"))
        if prompt and prompt.Enabled then
            for _, kw in ipairs(keywords) do
                local text = (tostring(prompt.ActionText) .. tostring(prompt.ObjectText)):lower()
                if text:find(kw) then
                    if holdTime and holdTime > 0 then
                        prompt:InputBegan()
                        task.wait(holdTime)
                        prompt:InputEnded()
                    else
                        if fireproximityprompt then fireproximityprompt(prompt) else prompt:InputBegan() task.wait(0.1) prompt:InputEnded() end
                    end
                    return true
                end
            end
        end
    end
    return false
end

-- ============= WEBHOOK SYSTEM =============
local function SendWebhook(msgType, extraData)
    if not FlowConfig.WebhookURL or FlowConfig.WebhookURL == "" or not requestFunc then return end
    
    local tag = ""
    local isDisconnect = (msgType == "Disconnect")
    if isDisconnect then
        tag = (FlowConfig.DiscordID ~= "") and "<@" .. FlowConfig.DiscordID .. ">" or "@everyone"
    end

    local embed = {}
    if isDisconnect then
        local reconText = FlowConfig.AutoReconnect and "\n\n**Status:** 🔄 *Reconnecting...*" or ""
        embed = {
            title = "🚨 DISCONNECT NOTICE",
            description = "Akun terputus." .. reconText,
            color = 0xFF4747,
            fields = {
                {name = "User", value = Player.Name, inline = true},
                {name = "Reason", value = tostring(extraData), inline = false}
            }
        }
    else
        if os.time() - Session.LastWebhook < 80 then return end
        Session.LastWebhook = os.time()
        local mins = math.floor((os.time() - Session.StartTime) / 60)
        embed = {
            title = "📊 FLOW STUDIO UPDATE",
            color = 0x47FFAB,
            fields = {
                {name = "User", value = Player.Name, inline = true},
                {name = "Profit", value = "$" .. Session.CurrentProfit, inline = true},
                {name = "Job", value = FlowConfig.Job, inline = true},
                {name = "Runtime", value = mins .. " Mins", inline = true}
            }
        }
    end

    pcall(function()
        requestFunc({
            Url = FlowConfig.WebhookURL, Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = Services.HttpService:JSONEncode({content = tag ~= "" and tag or nil, embeds = {embed}})
        })
    end)
end

-- ============= CORE ENGINE =============
local function runFarmCycle()
    while FlowConfig.AutoFarm do
        local root = getRoot()
        if not root then task.wait(1) continue end

        -- Auto Refuel (Diperbaiki)
        if FlowConfig.AutoRefuel then
            local veh, fuel = getVehicleInfo()
            if veh and fuel and fuel:IsA("NumberValue") and fuel.Value < 20 then
                addLog("Isi Bensin...")
                -- Pindahkan kendaraannya langsung
                if veh.PrimaryPart then
                    veh:SetPrimaryPartCFrame(CFrame.new(TP.GasStation + Vector3.new(0, 2, 0)))
                else
                    fastTP(TP.GasStation)
                end
                task.wait(1)
                interactPrompts({"fill", "refuel", "gas"}, 5)
                addLog("Bensin Penuh!")
            end
        end

        local item = Player.Backpack:FindFirstChild("Wheat") or Player.Backpack:FindFirstChild("CementBag")
        if not item and Player.Character then
            item = Player.Character:FindFirstChild("Wheat") or Player.Character:FindFirstChild("CementBag")
        end

        -- SMART SCAN LOGIC (Solusi nyangkut di 1 target)
        if FlowConfig.Job == "Haybales" then
            if not item then
                fastTP(TP.HaySupply)
                task.wait(FlowConfig.Speed)
                if interactPrompts({"wheat", "hay", "grab"}) then addLog("Ambil Hay") end
            else
                local delivered = false
                for _, horsePos in ipairs(Targets.Horses) do
                    if not FlowConfig.AutoFarm then break end
                    fastTP(horsePos)
                    task.wait(FlowConfig.Speed)
                    if interactPrompts({"feed", "horse", "deliver"}) then
                        addLog("Kuda diberi makan!")
                        delivered = true
                        break
                    end
                end
                if not delivered then addLog("Mencari kuda yang lapar...") end
            end

        elseif FlowConfig.Job == "Construction" then
            if not item then
                fastTP(TP.CementSupply)
                task.wait(FlowConfig.Speed)
                if interactPrompts({"cement", "bag", "grab"}) then addLog("Ambil Semen") end
            else
                local delivered = false
                for _, mixPos in ipairs(Targets.Mixers) do
                    if not FlowConfig.AutoFarm then break end
                    fastTP(mixPos)
                    task.wait(FlowConfig.Speed)
                    if interactPrompts({"pour", "mixer", "deliver"}) then
                        addLog("Semen dimasukkan!")
                        delivered = true
                        break
                    end
                end
                if not delivered then addLog("Mencari mixer kosong...") end
            end
        end
        task.wait(0.1)
    end
end

