task.spawn(function()
    task.wait(2)
    local function safeSet(obj, data)
        pcall(function() obj:SetValues(data) end)
    end
    while true do
        pcall(function()
            local ps  = LP:FindFirstChild("leaderstats")
            local cur = ps and ps:FindFirstChild("Money") and ps.Money.Value or 0
            if Ses.StartMoney == 0 and cur > 0 then Ses.StartMoney = cur end
            Ses.CurrentProfit = math.max(0, cur - Ses.StartMoney)
            local elapsed = math.max(1, math.floor((os.time() - Ses.StartTime) / 60))
            local pph     = math.floor(Ses.CurrentProfit / elapsed * 60)
            local ping    = math.floor(LP:GetNetworkPing() * 1000)

            local extra = ""
            if Cfg.AutoFarm and Cfg.AutoStop and Ses.FarmStart > 0 then
                local rem = math.max(0, Cfg.AutoStopMins - math.floor((os.time() - Ses.FarmStart) / 60))
                extra = "  ·  stop "..rem.."m"
            end

            safeSet(miniLog, {
                Title   = "Activity Log",
                Content = ("%s %s  |  %s%s\n$%d  ·  ~$%d/jam  ·  %dm  ·  %dms  ·  📦%d\n%s"):format(
                    Cfg.AutoFarm and "●" or "○",
                    Cfg.AutoFarm and "FARMING" or "Idle",
                    Cfg.Job, extra,
                    Ses.CurrentProfit, pph, elapsed, ping, Ses.Deliveries,
                    #Ses.Logs > 0 and table.concat(Ses.Logs, "\n") or "Belum ada aktivitas."
                )
            })

            local plist = {}
            for _, p in ipairs(Svc.Players:GetPlayers()) do
                plist[#plist+1] = (p == LP and "► " or "  ") .. p.Name
            end
            safeSet(playerInfo, {
                Title   = "Players Online (" .. #Svc.Players:GetPlayers() .. ")",
                Content = table.concat(plist, "\n"),
            })
        end)
        task.wait(1)
    end
end)

