    end
end)

local function SmartFarm()
    while _G.Flow_AutoFarm do
        local root = getRoot()
        if not root then task.wait(1) continue end

        local hasWheat = Player.Backpack:FindFirstChild("Wheat") or (Player.Character and Player.Character:FindFirstChild("Wheat"))
        if not hasWheat then
            root.CFrame = CFrame.new(POSISI_HAY + Vector3.new(0, 0.5, 0))
            task.wait(0.8)
            for _, v in pairs(workspace:GetPartBoundsInRadius(root.Position, 10)) do
                local p = v:FindFirstChildOfClass("ProximityPrompt") or (v.Parent and v.Parent:FindFirstChildOfClass("ProximityPrompt"))
                if p and (string.find(string.lower(p.ActionText), "wheat") or string.find(string.lower(p.ObjectText), "hay")) then
                    p.HoldDuration = _G.Flow_FarmSpeed
                    safeTrigger(p)
                    addLog("Ambil Jerami")
                    break
                end
            end
        end

        for i = 1, #POSISI_KUDA do
            if not _G.Flow_AutoFarm then break end
            root.CFrame = CFrame.new(POSISI_KUDA[kudaIndex] + Vector3.new(0, 0.5, 0))
            task.wait(1.0)
            
            local feedFound = false
            for _, v in pairs(workspace:GetPartBoundsInRadius(root.Position, 10)) do
                local p = v:FindFirstChildOfClass("ProximityPrompt") or (v.Parent and v.Parent:FindFirstChildOfClass("ProximityPrompt"))
                if p and (string.find(string.lower(p.ActionText), "feed") or string.find(string.lower(p.ObjectText), "horse")) then
                    p.HoldDuration = _G.Flow_FarmSpeed
                    safeTrigger(p)
                    addLog("Beri Makan Kuda #" .. kudaIndex)
                    feedFound = true
                    break
                end
            end
            kudaIndex = (kudaIndex % #POSISI_KUDA) + 1
            if feedFound then break end
            task.wait(0.2)
        end
        task.wait(0.1)
    end
end

