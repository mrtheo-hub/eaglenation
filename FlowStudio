local function holdPrompt(prompt)
    if not prompt then return end
    local holdTime = prompt.HoldDuration
    
    pcall(function() prompt:InputHoldBegin() end)
    task_wait(holdTime + 0.15)
    pcall(function() prompt:InputHoldEnd() end)
end

local function doAutoFarm()
    while autoFarmAktif do
        task_wait(0.1)
        
        local character = player.Character
        if not character or not character:FindFirstChild("HumanoidRootPart") then 
            -- Diubah dari bentuk 'continue' karena Lua 5.1 tidak mengenal kata kunci continue
        else
            local rootPart = character.HumanoidRootPart
            local activeDeliveries = Workspace:FindFirstChild("ActiveDeliveries")
            local packageSites = Workspace:FindFirstChild("PackageSites")
            local namaDelivery = player.Name .. "_Delivery"
            local myDelivery = activeDeliveries and activeDeliveries:FindFirstChild(namaDelivery)

            if myDelivery then
                local prompt = myDelivery:FindFirstChildOfClass("ProximityPrompt", true)
                if prompt then
                    local titikPas = getTitikKudaTerdekat(myDelivery.Position)
                    if titikPas then
                        rootPart.CFrame = titikPas
                        rootPart.AssemblyLinearVelocity = Vector3.new(0,0,0)
                        task_wait(1.5)
                        holdPrompt(prompt)
                        task_wait(2)
                    end
                end
            else
                local gatherSite = packageSites and packageSites:FindFirstChild("GatherPackageHay")
                if gatherSite then
                    local prompt = gatherSite:FindFirstChildOfClass("ProximityPrompt", true)
                    if prompt then
                        rootPart.CFrame = TitikWheat
                        rootPart.AssemblyLinearVelocity = Vector3.new(0,0,0)
                        task_wait(1.5)
                        holdPrompt(prompt)
                        task_wait(0.1) 
                    end
                else
                    local tpPoints = Workspace:FindFirstChild("TeleportPoints")
                    if tpPoints then
                        local teleportRanch = tpPoints:FindFirstChild("TeleportRanch")
                        if teleportRanch then
                            rootPart.CFrame = teleportRanch:GetPivot() + Vector3.new(0, 3, 0)
                            rootPart.AssemblyLinearVelocity = Vector3.new(0,0,0)
                            task_wait(0.1) 
                        end
                    end
                end
            end
        end
    end
end

local function handleToggle()
    autoFarmAktif = not autoFarmAktif
    if autoFarmAktif then
        ToggleButton.Text = "ON"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        task_spawn(doAutoFarm)
    else
        ToggleButton.Text = "OFF"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end
end
ToggleButton.MouseButton1Click:Connect(handleToggle)

local dragging, dragInput, dragStart, startPos

Frame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = Frame.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then 
                dragging = false 
            end
        end)
    end
end)

Frame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        Frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
