local POSISI_HAY = Vector3.new(13381.6962890625, 149.0471649169922, 2986.895751953125)
local POSISI_KUDA = {
    Vector3.new(13327.056640625, 149.11163330078125, 2942.324951171875),
    Vector3.new(13340.306640625, 149.11129760742188, 2951.826171875),
    Vector3.new(13352.1435546875, 149.1110076904297, 2960.876220703125),
    Vector3.new(13314.7734375, 149.11175537109375, 2960.294189453125)
}
local kudaIndex = 1

local function addLog(msg)
    table.insert(RecentActivity, 1, "[" .. os.date("%X") .. "] " .. msg)
    if #RecentActivity > 5 then table.remove(RecentActivity, 6) end
end

local function getRoot()
    return Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
end

local function safeTrigger(prompt)
    if not prompt then return end
    prompt:InputBegan()
    task.wait(prompt.HoldDuration + 0.1)
    prompt:InputEnded()
end

GuiService.ErrorMessageChanged:Connect(function()
    if _G.Flow_AutoReconnect then
