-- [IMPROVE] addLog: string.format sudah ada, tambah trim log lama
local function addLog(msg)
    local entry = string.format("[%s] %s", os.date("%X"), msg)
    table.insert(Session.Logs, 1, entry)
    if #Session.Logs > 8 then
        table.remove(Session.Logs)
    end
end

local function getRoot()
    return Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
end

-- [IMPROVE] fastTP: tambah pcall + validasi karakter hidup
local function fastTP(targetPos)
    local root = getRoot()
    if not root then return false end

    local humanoid = Player.Character:FindFirstChild("Humanoid")
    if humanoid and humanoid.Health <= 0 then return false end

    local ok, err = pcall(function()
        root.CFrame    = CFrame.new(targetPos + Vector3.new(0, 3, 0))
        root.Velocity  = Vector3.new(0, 0, 0)
        root.AssemblyLinearVelocity = Vector3.zero  -- Untuk versi engine baru
    end)

    if not ok then
        addLog("TP Error: " .. tostring(err))
        return false
    end

    task.wait(0.3)
    return true
end

-- [FIX MAJOR] interactPrompts: Perbaiki cara fire ProximityPrompt + fix syntax
local function interactPrompts(keywords, holdTime)
    local root = getRoot()
    if not root then return false end

    -- Scan semua part dalam radius 15 stud
    local partsInRange = Services.Workspace:GetPartBoundsInRadius(root.Position, 15)

    for _, part in ipairs(partsInRange) do
        -- Cari ProximityPrompt di part atau parent langsung
        local prompt = part:FindFirstChildOfClass("ProximityPrompt")
                    or (part.Parent and part.Parent:FindFirstChildOfClass("ProximityPrompt"))

        if prompt and prompt.Enabled then
            local combinedText = (tostring(prompt.ActionText) .. " " .. tostring(prompt.ObjectText)):lower()

            for _, kw in ipairs(keywords) do
                if combinedText:find(kw:lower()) then
                    -- [FIX] Cara yang benar untuk fire ProximityPrompt
                    local ok, fireErr = pcall(function()
                        if holdTime and holdTime > 0 then
                            -- Untuk hold-type prompts (misal isi bensin)
                            if fireproximityprompt then
                                fireproximityprompt(prompt)
                            else
                                -- Fallback manual hold
                                prompt.HoldDuration = holdTime
                                local conn
                                conn = prompt.PromptButtonHoldBegan:Connect(function() end)
                                task.wait(holdTime + 0.1)
                                conn:Disconnect()
                                prompt:FireServer()  -- Jika tersedia
                            end
                        else
                            -- [FIX] Satu baris per statement, bukan gabung
                            if fireproximityprompt then
                                fireproximityprompt(prompt)
                            else
                                -- Fallback: simulasi klik singkat
                                prompt.HoldDuration = 0
                                task.wait(0.05)
                            end
                        end
                    end)

                    if ok then
                        return true
                    else
                        addLog("Prompt Error: " .. tostring(fireErr))
                    end
                end
            end
        end
    end

    return false
end

-- [FIX] getVehicleInfo: Tambah nil-check sebelum akses .Parent dan child
local function getVehicleInfo()
    local char = Player.Character
    if not char then return nil, nil end

    local humanoid = char:FindFirstChild("Humanoid")
    if not humanoid then return nil, nil end

    local seatPart = humanoid.SeatPart
    if not seatPart then return nil, nil end

    -- [FIX] Pastikan SeatPart.Parent ada sebelum akses
    local vehicle = seatPart.Parent
    if not vehicle then return nil, nil end

    local fuel = vehicle:FindFirstChild("Fuel") or vehicle:FindFirstChild("Gas")
    return vehicle, fuel
end

