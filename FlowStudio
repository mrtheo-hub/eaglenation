local function SendWebhook(typ, extra)
    if Cfg.WebhookURL == "" or not reqFunc then return end
    local isDisc = typ == "Disconnect"
    if not isDisc then
        if os.time() - Ses.LastWebhook < 80 then return end
        Ses.LastWebhook = os.time()
    end
    local elapsed = math.max(1, math.floor((os.time() - Ses.StartTime) / 60))
    local pph     = math.floor(Ses.CurrentProfit / elapsed * 60)
    local tag     = isDisc and (Cfg.DiscordID ~= "" and "<@"..Cfg.DiscordID..">" or "@everyone") or nil
    local embed   = isDisc and {
        title = "🚨 DISCONNECT", color = 0xFF4747,
        description = "Terputus." .. (Cfg.AutoReconnect and " 🔄 Reconnecting..." or ""),
        fields = {
            {name="User",       value="`"..LP.Name.."`",         inline=true},
            {name="Reason",     value="`"..tostring(extra).."`", inline=false},
            {name="Profit",     value="$"..Ses.CurrentProfit,    inline=true},
            {name="Deliveries", value=tostring(Ses.Deliveries),  inline=true},
            {name="Time",       value=elapsed.."m",              inline=true},
        },
    } or {
        title = "📊 FLOW UPDATE", color = 0x8A5CE2,
        fields = {
            {name="User",       value="`"..LP.Name.."`",        inline=true},
            {name="Profit",     value="$"..Ses.CurrentProfit,   inline=true},
            {name="/Jam",       value="~$"..pph,                inline=true},
            {name="Deliveries", value=tostring(Ses.Deliveries), inline=true},
            {name="Job",        value=Cfg.Job,                  inline=true},
            {name="Time",       value=elapsed.."m",             inline=true},
        },
    }
    local ok, body = pcall(Svc.HttpService.JSONEncode, Svc.HttpService, {content=tag, embeds={embed}})
    if ok then
        pcall(reqFunc, {Url=Cfg.WebhookURL, Method="POST",
            Headers={["Content-Type"]="application/json"}, Body=body})
    end
end

local HAY_ITEMS   = {"Wheat","Hay","HayBale","Straw"}
local CEM_ITEMS   = {"Cement","CementBag","Concrete","Bag"}
local HAY_PICKUP  = {"wheat","hay","grab","pick","take","straw","bale","supply"}
-- [FIX] removed "give" and "deliver" — too broad, can match sell prompts
local HAY_DELIVER = {"feed","horse","hay","bucket","barn"}
local CEM_PICKUP  = {"cement","bag","grab","pick","take","concrete","supply","get"}
-- [FIX] removed "deliver" and "deposit" — too broad, can match sell prompts
local CEM_DELIVER = {"pour","mixer","fill","concrete","cement","add","dump"}

local function smartDeliver(targets, visited, itemNames, keywords)
    for i, pos in ipairs(targets) do
        if not Cfg.AutoFarm then return "stop" end
        if not visited[i] then
            fastTP(pos)
            task.wait(Cfg.FarmDelay)
            local fired = fireNearby(keywords)
            visited[i] = true
            if fired then
                task.wait(0.35)
                if not findItem(itemNames) then
                    Ses.Deliveries = Ses.Deliveries + 1
                    addLog("✅ #"..i.." sukses · total "..Ses.Deliveries)
                    return "ok"
                end
                addLog("⚠️ #"..i.." penuh, next...")
            end
        end
    end
    for i = 1, #targets do
        if not visited[i] then return "notDone" end
    end
    return "allDone"
end

local function runFarm()
    if Ses.FarmActive then return end
    Ses.FarmActive = true
    Ses.FarmStart  = os.time()
    Farm.VH, Farm.VM = {}, {}
    addLog("▶ " .. Cfg.Job)

    while Cfg.AutoFarm do
        if Cfg.AutoStop and Ses.FarmStart > 0 then
            if (os.time() - Ses.FarmStart) / 60 >= Cfg.AutoStopMins then
                Cfg.AutoFarm = false
                addLog("⏱ Auto-stop " .. Cfg.AutoStopMins .. "m")
                break
            end
        end

        if not getRoot() then
            task.wait(1)
        else
            if Cfg.AutoRefuel then
                local hum = getHum()
                if hum and hum.SeatPart then
                    local veh  = hum.SeatPart.Parent
                    local fuel = veh and (veh:FindFirstChild("Fuel") or veh:FindFirstChild("Gas"))
                    if fuel and fuel.Value < 20 then
                        addLog("⛽ Refuel...")
                        if veh.PrimaryPart then
                            pcall(function() veh:SetPrimaryPartCFrame(CFrame.new(TPos.GasStation + Vector3.new(0,2,0))) end)
                        else
                            fastTP(TPos.GasStation)
                        end
                        task.wait(1)
                        fireNearby({"fill","refuel","gas","pump"}, 5)
                    end
                end
            end

            if Cfg.Job == "Haybales" then
                if not findItem(HAY_ITEMS) then
                    fastTP(TPos.HaySupply)
                    task.wait(Cfg.FarmDelay)
                    fireNearby(HAY_PICKUP)
                    task.wait(0.35)
                    if findItem(HAY_ITEMS) then
                        Farm.VH = {}
                        addLog("🌾 Hay diambil")
                    else
                        addLog("⚠️ Gagal ambil hay")
                        task.wait(0.5)
                    end
                else
                    local res = smartDeliver(Targets.Horses, Farm.VH, HAY_ITEMS, HAY_DELIVER)
                    if res == "ok"          then Farm.VH = {}
                    elseif res == "allDone" then addLog("🔄 Semua kuda kenyang, 3s"); Farm.VH = {}; task.wait(3)
                    elseif res == "stop"    then break end
                end

            elseif Cfg.Job == "Construction" then
                if not findItem(CEM_ITEMS) then
                    fastTP(TPos.CemSupply)
                    task.wait(Cfg.FarmDelay)
                    fireNearby(CEM_PICKUP)
                    task.wait(0.35)
                    if findItem(CEM_ITEMS) then
                        Farm.VM = {}
                        addLog("🧱 Semen diambil")
                    else
                        addLog("⚠️ Gagal ambil semen")
                        task.wait(0.5)
                    end
                else
                    local res = smartDeliver(Targets.Mixers, Farm.VM, CEM_ITEMS, CEM_DELIVER)
                    if res == "ok"          then Farm.VM = {}
                    elseif res == "allDone" then addLog("🔄 Semua mixer penuh, 3s"); Farm.VM = {}; task.wait(3)
                    elseif res == "stop"    then break end
                end
            end

            SendWebhook("Update")
            task.wait(0.02)
        end
    end

    Ses.FarmActive = false
    addLog("⏹ Berhenti · " .. Ses.Deliveries .. " deliver")
end

local discFired = false
local function onDisconnect(reason)
    if discFired then return end
    discFired = true
    addLog("❌ " .. tostring(reason))
    SendWebhook("Disconnect", reason)
    if Cfg.AutoExecURL ~= "" and writefile then
        pcall(writefile, "autoexec/flow_autorun.lua",
            ('loadstring(game:HttpGet("%s"))()'):format(Cfg.AutoExecURL))
    end
    if Cfg.AutoReconnect then
        for i = 5, 1, -1 do
            addLog("🔄 Reconnect " .. i .. "s...")
            task.wait(1)
        end
        local ok = pcall(Svc.TeleportService.Teleport, Svc.TeleportService, game.PlaceId, LP)
        if not ok then
            pcall(function()
                Svc.TeleportService:TeleportAsync(game.PlaceId, {LP}, Instance.new("TeleportOptions"))
            end)
        end
    end
end
