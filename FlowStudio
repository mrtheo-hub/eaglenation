-- /// FUNCTIONS ///

local function getRoot()
    return Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
end

local function teleport(pos)
    local root = getRoot()
    if not root then return end
    
    if Toggles.Tween then
        local dist = (root.Position - pos).Magnitude
        local info = TweenInfo.new(dist/Config.Speed, Enum.EasingStyle.Linear)
        local tween = TweenService:Create(root, info, {CFrame = CFrame.new(pos + Vector3.new(0, 0.5, 0))})
        tween:Play()
        tween.Completed:Wait()
    else
        root.CFrame = CFrame.new(pos + Vector3.new(0, 0.5, 0))
        task.wait(0.5)
    end
end

local function fireInteraction(prompt)
    if prompt and fireproximityprompt then
        fireproximityprompt(prompt) -- Using direct fire as requested
        return true
    end
    return false
end

