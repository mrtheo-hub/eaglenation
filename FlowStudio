local PlayerTab = Window:MakeTab({"Player", "user"})

-- /// FUNCTIONS ///
local function getRoot()
    return game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
end

local function teleport(pos)
    local root = getRoot()
    if not root then return end
    local tween = game:GetService("TweenService"):Create(root, TweenInfo.new((root.Position - pos).Magnitude / Config.Speed, Enum.EasingStyle.Linear), {CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))})
    tween:Play()
    tween.Completed:Wait()
end

-- Infinite Jump
game:GetService("UserInputService").JumpRequest:Connect(function()
    if Toggles.InfJump then
        game.Players.LocalPlayer.Character:FindFirstChildOfClass("Humanoid"):ChangeState("Jumping")
    end
end)

-- /// FARM LOOP ///
task.spawn(function()
    while true do
        task.wait(0.1)
        if Toggles.Farm then
            local p = game.Players.LocalPlayer
            local inv = p.Backpack:FindFirstChild("Wheat") or p.Character:FindFirstChild("Wheat")
            
            -- Step 1: Get Hay[cite: 1]
            if not inv then
                teleport(POS_HAY)
                task.wait(0.3)
                for _, v in pairs(workspace:GetPartBoundsInRadius(getRoot().Position, 10)) do
                    local prompt = v:FindFirstChildOfClass("ProximityPrompt") or v.Parent:FindFirstChildOfClass("ProximityPrompt")
                    if prompt then fireproximityprompt(prompt) break end
                end
                task.wait(Config.Delay)
            end

            -- Step 2: Feed Horse[cite: 1]
            if Toggles.Farm then
                teleport(POS_HORSES[horseIndex])
                task.wait(0.3)
                for _, v in pairs(workspace:GetPartBoundsInRadius(getRoot().Position, 10)) do
                    local prompt = v:FindFirstChildOfClass("ProximityPrompt") or v.Parent:FindFirstChildOfClass("ProximityPrompt")
                    if prompt then fireproximityprompt(prompt) break end
                end
                task.wait(Config.Delay)
                horseIndex = (horseIndex % #POS_HORSES) + 1
            end
        end
    end
end)

