local function addLog(msg)
    table.insert(Session.Logs, 1, string.format("[%s] %s", os.date("%X"), msg))
    if #Session.Logs > 6 then table.remove(Session.Logs, 7) end
end

local function getRoot()
    return Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
end

local function getVehicle()
    local char = Player.Character
    if char and char:FindFirstChild("Humanoid") and char.Humanoid.SeatPart then
        return char.Humanoid.SeatPart.Parent
    end
    return nil
end

-- ============= PHYSICS-SAFE TWEEN =============
local function tweenTo(targetPos)
    local root = getRoot()
    if not root or not FlowConfig.AutoFarm then return false end
    
    local distance = (root.Position - targetPos).Magnitude
    if distance < 0.5 then return true end
    
    local direction = (targetPos - root.Position).Unit
    local tInfo = TweenInfo.new(distance / FlowConfig.TweenSpeed, Enum.EasingStyle.Linear)
    local tween = Services.TweenService:Create(root, tInfo, {CFrame = CFrame.new(targetPos)})
    
    local velocitySync
    velocitySync = Services.RunService.Heartbeat:Connect(function()
        if not FlowConfig.AutoFarm or not root.Parent then
            velocitySync:Disconnect()
            return
        end
        root.AssemblyLinearVelocity = direction * FlowConfig.TweenSpeed
    end)
    
    tween:Play()
    
    local completed = false
    local connection
    connection = tween.Completed:Connect(function()
        completed = true
        if velocitySync then velocitySync:Disconnect() end
        root.AssemblyLinearVelocity = Vector3.new(0,0,0)
        connection:Disconnect()
    end)
    
    -- Interruptible Wait
    while not completed and FlowConfig.AutoFarm do
        task.wait(0.1)
    end
    
    if not FlowConfig.AutoFarm then
        tween:Cancel()
        if velocitySync then velocitySync:Disconnect() end
        root.AssemblyLinearVelocity = Vector3.new(0,0,0)
    end
    
    return completed
end

-- ============= SMART PROMPT INTERACTION =============
local function interactPrompts(keywords, holdTime)
    local root = getRoot()
    if not root then return false end
    for _, part in ipairs(Services.Workspace:GetPartBoundsInRadius(root.Position, 15)) do
        local prompt = part:FindFirstChildOfClass("ProximityPrompt") or (part.Parent and part.Parent:FindFirstChildOfClass("ProximityPrompt"))
        if prompt and prompt.Enabled then
            for _, kw in ipairs(keywords) do
                local text = (tostring(prompt.ActionText) .. tostring(prompt.ObjectText)):lower()
                if text:find(kw) then
                    if holdTime and holdTime > 0 then
                        prompt:InputBegan()
                        task.wait(holdTime)
                        prompt:InputEnded()
                    else
                        if fireproximityprompt then
                            fireproximityprompt(prompt)
                        else
                            prompt:InputBegan()
                            task.wait(0.1)
                            prompt:InputEnded()
                        end
                    end
                    return true
                end
            end
        end
    end
    return false
end

-- ============= ADVANCED WEBHOOK V3 =============
local function SendWebhook(msgType, extraData)
    if not FlowConfig.WebhookURL or FlowConfig.WebhookURL == "" or not requestFunc then return end
    
    local tag = ""
    local isDisconnect = (msgType == "Disconnect")
    
    if isDisconnect then
        tag = (FlowConfig.DiscordID ~= "") and "<@" .. FlowConfig.DiscordID .. ">" or "@everyone"
    end

    local embed = {}
    if isDisconnect then
        local reconText = FlowConfig.AutoReconnect and "\n\n**Status:** 🔄 *Reconnecting to server...*" or ""
        embed = {
            title = "🚨 DISCONNECT NOTICE",
            description = "Akun telah terputus dari server." .. reconText,
            color = 0xFF4747,
            fields = {
                {name = "Account", value = "||" .. Player.Name .. "||", inline = true},
                {name = "Error Code / Reason", value = tostring(extraData), inline = false}
            },
            footer = {text = "Flow Hub Protection System"},
            timestamp = DateTime.now():ToIsoDate()
        }
    else
        if os.time() - Session.LastWebhookUpdate < 80 then return end
        Session.LastWebhookUpdate = os.time()
        
        local timeMinutes = math.floor((os.time() - Session.StartTime) / 60)
        embed = {
            title = "📊 FLOW STUDIO UPDATE",
            color = 0x47FFAB,
            fields = {
                {name = "User", value = "||" .. Player.Name .. "||", inline = true},
                {name = "Net Profit", value = "**$" .. Session.CurrentProfit .. "**", inline = true},
                {name = "Current Job", value = FlowConfig.Job, inline = true},
                {name = "Runtime", value = timeMinutes .. " Mins", inline = true}
            },
            footer = {text = "Flow Hub"},
            timestamp = DateTime.now():ToIsoDate()
        }
    end

    local payload = {
        content = tag ~= "" and tag or nil,
        embeds = {embed}
    }

    pcall(function()
        requestFunc({
            Url = FlowConfig.WebhookURL,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = Services.HttpService:JSONEncode(payload)
        })
    end)
end

