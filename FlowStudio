local function addLog(msg)
    table.insert(Ses.Logs, 1, ("[%s] %s"):format(os.date("%X"), msg))
    if #Ses.Logs > 14 then table.remove(Ses.Logs) end
end

local function getRoot() return LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") end
local function getHum()  return LP.Character and LP.Character:FindFirstChild("Humanoid") end

local function findItem(names)
    for _, name in ipairs(names) do
        local low = name:lower()
        if LP.Backpack:FindFirstChild(name) then return true end
        if LP.Character and LP.Character:FindFirstChild(name) then return true end
        for _, o in ipairs(LP.Backpack:GetChildren()) do
            if o:IsA("Tool") and o.Name:lower():find(low, 1, true) then return true end
        end
        if LP.Character then
            for _, o in ipairs(LP.Character:GetChildren()) do
                if o:IsA("Tool") and o.Name:lower():find(low, 1, true) then return true end
            end
        end
    end
    return false
end

local function fastTP(pos)
    local root = getRoot()
    if not root then return false end
    pcall(function()
        root.CFrame = CFrame.new(pos + Vector3.new(0, 3.5, 0))
        root.AssemblyLinearVelocity = Vector3.zero
    end)
    task.wait(0.05)
    return true
end

local function fireNearby(keywords, holdTime)
    local root = getRoot()
    if not root then return false end
    local seen = {}
    for _, part in ipairs(Svc.Workspace:GetPartBoundsInRadius(root.Position, 22)) do
        local obj = part
        for _ = 1, 5 do
            if not obj or obj == Svc.Workspace then break end
            if not seen[obj] then
                seen[obj] = true
                for _, ch in ipairs(obj:GetChildren()) do
                    if ch:IsA("ProximityPrompt") and ch.Enabled then
                        local txt = (ch.ActionText .. " " .. ch.ObjectText):lower()
                        local match = not keywords
                        if not match then
                            for _, kw in ipairs(keywords) do
                                if txt:find(kw, 1, true) then match = true; break end
                            end
                        end
                        if match then
                            local ok = pcall(function()
                                if fireproximityprompt then
                                    if holdTime and holdTime > 0 then
                                        fireproximityprompt(ch, holdTime)
                                    else
                                        fireproximityprompt(ch)
                                    end
                                else
                                    local dur = (holdTime and holdTime > 0) and holdTime or ch.HoldDuration
                                    if dur > 0 then task.wait(dur + 0.1) end
                                end
                            end)
                            if ok then return true end
                        end
                    end
                end
            end
            obj = obj.Parent
        end
    end
    return false
end

