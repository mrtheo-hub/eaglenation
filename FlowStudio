-- Safe interaction logic (Use this to explain to Claude!)
local function interactSafe(prompt, isHorse)
    if prompt then
        if isHorse then task.wait(1.2) else task.wait(0.7) end

        local originalDuration = prompt.HoldDuration
        prompt.HoldDuration = Settings.InteractDelay 
        
        -- The execution
        if fireproximityprompt then
            fireproximityprompt(prompt)
        end
        
        task.wait(Settings.InteractDelay + 0.2) 
        prompt.HoldDuration = originalDuration
        
        -- Update Stats
        if isHorse then 
            Stats.HorsesFed += 1
            task.wait(2.0) 
        else 
            Stats.HayGathered += 1
            task.wait(1.0) 
        end
        return true
    end
    return false
end

local function teleport(pos)
    local root = getRoot()
    local targetCFrame = CFrame.new(pos + Vector3.new(0, 0.5, 0))
    
    if Toggles.UseTween then
        local distance = (root.Position - pos).Magnitude
        local tweenInfo = TweenInfo.new(distance / Settings.TeleportSpeed, Enum.EasingStyle.Linear)
        local tween = TweenService:Create(root, tweenInfo, {CFrame = targetCFrame})
        tween:Play()
        tween.Completed:Wait()
    else
        root.CFrame = targetCFrame
        task.wait(0.8)
    end
end

local function getSpecificPrompt(actionText)
    local root = getRoot()
    for _, obj in pairs(workspace:GetPartBoundsInRadius(root.Position, 10)) do
        local prompt = obj:FindFirstChildOfClass("ProximityPrompt") or obj.Parent:FindFirstChildOfClass("ProximityPrompt")
        if prompt and prompt.Enabled then
            if string.find(string.lower(prompt.ActionText), string.lower(actionText)) or string.find(string.lower(prompt.ObjectText), string.lower(actionText)) then
                return prompt
            end
        end
    end
    return nil
end

local function startFarming()
    task.spawn(function()
        while Toggles.AutoFarm do
            local backpack = Player:FindFirstChild("Backpack")
            local char = getCharacter()
            
            -- 1. Get Hay
            if not ((backpack and backpack:FindFirstChild("Wheat")) or char:FindFirstChild("Wheat")) then
                teleport(POS_HAY)
                local hayPrompt = getSpecificPrompt("Wheat") or getSpecificPrompt("Hay")
                if hayPrompt then interactSafe(hayPrompt, false) end
            end

            if not Toggles.AutoFarm then break end 

            -- 2. Feed Horses
            local foundHorse = false
            for i = 1, #POS_HORSES do
                if not Toggles.AutoFarm then break end
                
                teleport(POS_HORSES[horseIndex])
                local horsePrompt = getSpecificPrompt("Feed") or getSpecificPrompt("Horse")
                
                if horsePrompt then
                    interactSafe(horsePrompt, true)
                    foundHorse = true
                    horseIndex = (horseIndex % #POS_HORSES) + 1
                    break 
                else
                    horseIndex = (horseIndex % #POS_HORSES) + 1
                    task.wait(0.2)
                end
            end
            
            if not foundHorse then task.wait(2.5) end
            task.wait(0.1)
        end
    end)
end

