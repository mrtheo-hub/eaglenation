-- CORE AUTOMATION ENGINE
local function MainEngine()
    while _G.Flow_AutoFarm do
        local root = getRoot()
        if not root then task.wait(1) continue end

        if _G.Flow_SelectedJob == "Haybales" then
            -- JOB 1: HAYBALES
            local hasItem = Player.Backpack:FindFirstChild("Wheat") or (Player.Character and Player.Character:FindFirstChild("Wheat"))
            if not hasItem then
                root.CFrame = CFrame.new(POS_HAY + Vector3.new(0, 1, 0))
                task.wait(0.5)
                local p = findPrompt({"Wheat", "Hay", "Grab"})
                if p then interact(p) addLog("Grabbed Hay") task.wait(_G.Flow_FarmSpeed) end
            else
                local target = POS_HORSES[targetIndex]
                root.CFrame = CFrame.new(target + Vector3.new(0, 1, 0))
                task.wait(0.5)
                local p = findPrompt({"Feed", "Horse", "Deliver"})
                if p then 
                    interact(p) 
                    addLog("Fed Horse #" .. targetIndex) 
                    targetIndex = (targetIndex % #POS_HORSES) + 1
                    task.wait(_G.Flow_FarmSpeed)
                else
                    targetIndex = (targetIndex % #POS_HORSES) + 1 -- Skip if no prompt
                end
            end

        elseif _G.Flow_SelectedJob == "Construction" then
            -- JOB 2: CONSTRUCTION
            local hasItem = Player.Backpack:FindFirstChild("CementBag") or (Player.Character and Player.Character:FindFirstChild("CementBag"))
            if not hasItem then
                root.CFrame = CFrame.new(POS_CEMENT + Vector3.new(0, 1, 0))
                task.wait(0.5)
                local p = findPrompt({"Cement", "Bag", "Grab"})
                if p then interact(p) addLog("Grabbed Cement") task.wait(_G.Flow_FarmSpeed) end
            else
                local target = POS_MIXERS[targetIndex]
                root.CFrame = CFrame.new(target + Vector3.new(0, 1, 0))
                task.wait(0.5)
                local p = findPrompt({"Pour", "Mixer", "Deliver"})
                if p then 
                    interact(p) 
                    addLog("Poured Mixer #" .. targetIndex) 
                    targetIndex = (targetIndex % #POS_MIXERS) + 1
                    task.wait(_G.Flow_FarmSpeed)
                else
                    targetIndex = (targetIndex % #POS_MIXERS) + 1
                end
            end
        end
        task.wait(0.1)
    end
end

