-- UTILITIES
local function addLog(msg)
    table.insert(RecentActivity, 1, "[" .. os.date("%X") .. "] " .. msg)
    if #RecentActivity > 5 then table.remove(RecentActivity, 6) end
end

local function getRoot()
    return Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
end

-- FUNCTION: FIRE PROXIMITY PROMPT (REINSTATED)
local function interact(prompt)
    if not prompt then return end
    if fireproximityprompt then
        fireproximityprompt(prompt)
    else
        -- Fallback manual jika executor tidak support fireproximityprompt
        prompt:InputBegan()
        task.wait(0.1)
        prompt:InputEnded()
    end
end

-- FUNCTION: FIND NEARBY PROMPT
local function findPrompt(names)
    local root = getRoot()
    if not root then return nil end
    for _, v in pairs(workspace:GetPartBoundsInRadius(root.Position, 12)) do
        local p = v:FindFirstChildOfClass("ProximityPrompt") or (v.Parent and v.Parent:FindFirstChildOfClass("ProximityPrompt"))
        if p and p.Enabled then
            for _, name in pairs(names) do
                if p.ActionText:lower():find(name:lower()) or p.ObjectText:lower():find(name:lower()) then
                    return p
                end
            end
        end
    end
    return nil
end

