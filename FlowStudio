local function startup()
    refreshSources()

    -- Capability-gated: this signal is restricted on some clients/executors.
    local disconnectOK = pcall(function()
        track(GuiService.ErrorMessageChanged:Connect(function(message)
            if type(message) == "string" and message ~= "" then
                disconnected()
            end
        end))
    end)
    state.disconnectStatus = disconnectOK
        and "Disconnect listener available (best effort)"
        or "Disconnect signal unavailable on this client"

    setAntiAFK(options.antiAFK)

    track(player.CharacterRemoving:Connect(function()
        state.generation = state.generation + 1
        cancelConfirmation("Waiting for respawn")
        releasePrompt()
        if state.running then state.status = "Waiting for respawn" end
    end))

    -- Exactly one worker. ON/OFF invalidates a generation instead of spawning loops.
    table.insert(threads, task.spawn(function()
        while state.alive do
            if state.running and not state.disconnected then
                local token = state.generation
                local ok, result, reason = pcall(farmStep, token)
                releasePrompt()

                if validRun(token) then
                    if not ok or result == false then
                        state.failures = state.failures + 1
                        state.status = ok
                            and (reason or "Attempt failed")
                            or "Farm error; retrying"

                        if state.failures >= options.maxFailures then
                            setRunning(
                                false,
                                "Stopped after " .. state.failures .. " failed attempts"
                            )
                            notify(
                                "Farming paused",
                                reason or "Repeated farm errors. Check job objects and character, then restart."
                            )
                        else
                            pause(1, token)
                        end
                    elseif result == true then
                        state.failures = 0
                    end
                end
            end
            task.wait(0.1)
        end
    end))

    table.insert(threads, task.spawn(function()
        local lastScan = os.clock()
        while state.alive do
            if not state.disconnected then
                if os.clock() - lastScan >= 5 then
                    refreshSources()
                    lastScan = os.clock()
                end

                if state.source then
                    local balance = readSource(state.source)
                    if balance ~= nil then
                        acceptBalance(balance)
                    else
                        state.balance = nil
                        state.moneyStatus = "Money source unavailable; tracking paused"
                        pauseForMissingMoney()
                    end
                end

                checkTarget()
                if options.reports and options.periodic
                    and os.clock() - state.lastReport >= options.interval then
                    state.lastReport = os.clock()
                    sendReport("Session update", false)
                end
            end

            local seconds = elapsed()
            local target = options.target > 0 and (
                amount(state.earned) .. " / " .. amount(options.target)
                .. " (" .. string.format(
                    "%.1f",
                    math.min(100, state.earned / options.target * 100)
                ) .. "%)"
            ) or "Disabled"

            updateParagraph(dashboard, table.concat({
                "Status: " .. state.status,
                "Playtime: " .. duration(seconds),
                "Earned: " .. amount(state.earned) .. "  |  Spent: " .. amount(state.spent),
                "Net: " .. amount(state.earned - state.spent)
                    .. "  |  Balance: " .. amount(state.balance),
                "Earnings / hour: "
                    .. amount(seconds > 0 and state.earned * 3600 / seconds or 0),
                "Target: " .. target,
                "Confirmed deliveries: " .. state.deliveries
                    .. "  |  Failed attempts: " .. state.failures,
            }, "\n"))

            updateParagraph(
                sourceInfo,
                state.moneyStatus .. "\nCurrent balance: " .. amount(state.balance)
            )
            updateParagraph(
                reportInfo,
                state.webhookStatus
                    .. "\nReports: " .. (options.reports and "Enabled" or "Disabled")
                    .. "\n" .. state.disconnectStatus
            )
            task.wait(1)
        end
    end))
end

